{
  "name": "a-center",
  "version": "0.5.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "electron . --dev",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/smoke.mjs",
    "test:ai": "tsx --test scripts/ai.test.ts",
    "test:credentials": "electron scripts/credentials-smoke.cjs",
    "test:ui": "tsx scripts/ui-smoke.ts",
    "test:local": "tsx --test scripts/llama.test.ts",
    "test:files": "tsx --test scripts/local-files.test.ts",
    "bench:local": "tsx scripts/benchmark-local.ts",
    "test:roblox": "tsx --test scripts/roblox.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "drizzle-orm": "0.45.2",
    "next": "16.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.vex.a-center",
    "productName": "A-Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "drizzle/**/*",
      ".next/**/*",
      "public/**/*",
      "src/**/*"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
